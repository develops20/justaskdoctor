# Deterministic workflow (recommended for demos)
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI Realtime / GPT-Live-1
# This permanent key is read only by app/api/live/session/route.ts.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-realtime-2.1
OPENAI_REASONING_MODEL=

# Exa research (optional; bundled official sources are used without it)
EXA_API_KEY=

# CopilotKit (optional adapter; leave blank for the local deterministic UI)
NEXT_PUBLIC_COPILOTKIT_RUNTIME_URL=

# Optional stretch integration
AMBIGUOUS_API_KEY=
